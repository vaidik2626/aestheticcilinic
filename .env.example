# ─── Base de datos (PostgreSQL) ──────────────────────────────────────────────
# Cadena de conexión de PostgreSQL. En Vercel, usa la URL "pooled" de tu proveedor
# (Neon, Supabase, Prisma Postgres, etc.).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/claudia_hernandez?schema=public"

# ─── Sitio ───────────────────────────────────────────────────────────────────
# URL pública canónica, sin barra final. Se usa para SEO, sitemap y Open Graph.
NEXT_PUBLIC_SITE_URL="https://www.tu-dominio.com"

# ─── Correo de confirmación (opcional, Resend) ───────────────────────────────
# Si no se configuran, las reservas se guardan igual pero no se envían correos.
RESEND_API_KEY=""
# Remitente verificado en Resend, p. ej. "Centro Estético Claudia Hernández <citas@tu-dominio.com>"
EMAIL_FROM=""
# Correo donde el centro recibe el aviso de nuevas solicitudes.
CLINIC_NOTIFICATION_EMAIL=""

# ─── Administrador inicial (solo para `npm run admin:create`) ────────────────
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# ─── Opcional ────────────────────────────────────────────────────────────────
# Máximo de conexiones del pool. Déjalo vacío en producción; usa 1 con `npx prisma dev`.
DATABASE_POOL_MAX=""
